    <a href="#kontak">Kontak</a>
  </nav>

  <section id="profil" class="section">
    <h2>Tentang Saya</h2>
    <p>Halo! Nama saya [Nama Kamu]. Saya adalah seorang [pekerjaan atau minat], dan ini adalah portofolio saya. Saya suka membuat karya visual dan berbagi ide kreatif lewat berbagai media.</p>
  </section>

  <section id="galeri" class="section">
    <h2>Galeri Foto & Video</h2>
    <div class="gallery">
      <img src="link-ke-foto1.jpg" alt="Karya 1">
      <video controls src="link-ke-video1.mp4"></video>
      <!-- Tambahkan lebih banyak foto atau video sesuai kebutuhan -->
    </div>
  </section>

  <section id="karya" class="section">
    <h2>Karya Saya</h2>
    <ul>
      <li><a href="https://youtube.com/namachannel">Channel YouTube</a></li>
      <li><a href="https://link-lain.com">Karya lainnya</a></li>
    </ul>
  </section>

  <section id="kontak" class="section">
    <h2>Kontak</h2>
    <p>Email: kamu@email.com</p>
    <p>WhatsApp: 08xxxxxxxxxx</p>
  </section>

  <footer>
    <p>&copy; 2025 [Nama Kamu] - Semua Hak Dilindungi</p>
  </footer>

</body>
</html>
